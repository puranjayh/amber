# Loop store. Without these, Next falls back to .data/loop.json.
# Server-only key — the browser never talks to Postgres. Either the new
# secret key (sb_secret_…) or the legacy service_role JWT works here.
# Never use the publishable/anon key: every table has RLS on with no policies.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
